# =============================================================
# CareFlow AI — Root .gitignore
# =============================================================

# ---- Environment / Secrets (NEVER commit these) ----
.env
.env.local
.env.production
.env.staging
*.env

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Python test cache ----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- SQLite local dev databases ----
*.db
*.sqlite3

# ---- Node / Frontend ----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDEs ----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Alembic ----
# (keep versions/ tracked, ignore only local migration env overrides)

# ---- Render / Vercel ----
.vercel/
