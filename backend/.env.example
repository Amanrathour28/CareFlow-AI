# CareFlow AI — Backend Environment Variables
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to git.

PROJECT_NAME="CareFlow AI"
API_V1_STR="/api/v1"

# Security — generate a strong random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev_secret_key_placeholder_must_be_changed_in_prod"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database — local dev uses local PostgreSQL; production uses Neon connection string
# Neon format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/careflow_ai"

# CORS — set to your Vercel deployment URL in production
# Example: https://careflow-ai.vercel.app
FRONTEND_URL=""

# AI Layer — optional. Leave blank to use built-in rule-based fallback.
# Get a free key at: https://console.groq.com
GROQ_API_KEY=""
